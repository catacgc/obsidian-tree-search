{
  "name": "@mdtree/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mdtree": "./src/main.ts"
  },
  "exports": {
    ".": "./src/main.ts",
    "./vault": "./src/vault/indexer.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build --compile --target=bun src/main.ts --outfile=../../dist/mdtree",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdtree/core": "workspace:*",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "ignore": "^7.0.5",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.8.3"
  }
}
