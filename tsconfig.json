{
    "compilerOptions": {
        "types": [
            "react",
            "node",
            "obsidian-typings",
            "bun"
        ],
        "baseUrl": ".",
        "jsx": "react-jsx",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "allowImportingTsExtensions": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "packages"
    ]
}
