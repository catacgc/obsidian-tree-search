{
	"name": "obsidian-tree-search",
	"workspaces": ["packages/*"],
	"version": "0.12.0",
	"description": "All in one graph search, quick switcher, bookmark manager and MOC manager",
	"main": "main.js",
	"scripts": {
		"test": "bun test",
		"build": "node_modules/.bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"mdtree:build": "bun build --compile --target=bun packages/cli/src/main.ts --outfile=dist/mdtree",
		"mdtree:test": "bun test packages/core/src/__tests__",
		"mdtree:dev": "bun run packages/cli/src/main.ts"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.4.1",
		"@codemirror/view": "6.33.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^20.0.0",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"autoprefixer": "^10.4.21",
		"builtin-modules": "3.3.0",
		"bunshi": "^2.1.5",
		"esbuild": "0.17.3",
		"esbuild-plugin-tailwindcss": "^2.0.1",
		"npm-run-all": "^4.1.5",
		"obsidian": "latest",
		"obsidian-typings": "^2.2.0",
		"postcss": "^8.5.3",
		"postcss-nested": "^7.0.2",
		"postcss-prefix-selector": "^2.1.1",
		"tailwindcss": "^4.1.7",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@mdtree/core": "workspace:*",
		"jotai": "^2.16.0",
		"jotai-effect": "^2.0.4",
		"js-yaml": "^4.1.0",
		"lucide-react": "^0.468.0",
		"markdown-it": "^14.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
